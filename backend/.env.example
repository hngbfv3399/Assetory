# `bash scripts/run-local.sh` loads this file for local development.
# Values are shell-sourced, so quote values that contain special characters.
DB_URL='jdbc:mysql://localhost:3306/assetory?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME='assetory_app'
DB_PASSWORD='replace-with-your-local-app-password'
JWT_SECRET='replace-with-a-random-secret-of-at-least-32-bytes'
JWT_ACCESS_TOKEN_EXPIRATION=1800
JWT_REFRESH_TOKEN_EXPIRATION=1209600
