{
  "info": {
    "_postman_id": "66af7300-4f64-4ca9-bab4-2c0b5a350c98",
    "name": "Assetory - Phase 04 Seller Product Management",
    "description": "4단계 판매자 상품 관리 API 검증용 Collection입니다. sellerEmail과 sellerPassword 환경변수를 입력한 뒤 Runner를 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "sellerProductId", "value": "" },
    { "key": "imageId", "value": "" },
    { "key": "resourceId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "판매자 로그인",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\"\n}" }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.success).to.eql(true);", "pm.collectionVariables.set('accessToken', body.data.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "2. Product Lifecycle",
      "item": [
        {
          "name": "상품 등록 - DRAFT",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"Postman 판매자 검증 상품\",\n  \"summary\": \"판매자 상품 관리 Collection 검증용\",\n  \"description\": \"자동 검증으로 생성된 상품입니다.\",\n  \"price\": 1000\n}" }, "url": "{{baseUrl}}/api/seller/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.data.status).to.eql('DRAFT');", "pm.collectionVariables.set('sellerProductId', body.data.id);"] } }]
        },
        {
          "name": "판매 준비 부족 - publish 차단",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/publish" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json().data.code).to.eql('PRODUCT_NOT_READY');"] } }]
        },
        {
          "name": "대표 이미지 등록",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"imageUrl\": \"https://example.com/postman-thumbnail.jpg\",\n  \"originalName\": \"postman-thumbnail.jpg\",\n  \"isThumbnail\": true\n}" }, "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/images" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.data.isThumbnail).to.eql(true);", "pm.collectionVariables.set('imageId', body.data.id);"] } }]
        },
        {
          "name": "구매 자료 등록",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman 이용 링크\",\n  \"type\": \"LINK\",\n  \"url\": \"https://example.com/postman-resource\"\n}" }, "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/resources" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.data.type).to.eql('LINK');", "pm.collectionVariables.set('resourceId', body.data.id);"] } }]
        },
        {
          "name": "판매 시작 - 공개 노출",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/publish" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data).to.eql('ON_SALE');"] } }]
        },
        {
          "name": "판매 중지 - 공개 비노출",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/suspend" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data).to.eql('STOPPED');"] } }]
        }
      ]
    },
    {
      "name": "3. Ownership and Cleanup",
      "item": [
        {
          "name": "내 상품 상세 - 자료 URL 비노출",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "const resource = pm.response.json().data.resources[0];", "pm.expect(resource).to.not.have.property('url');", "pm.expect(resource).to.have.property('name');"] } }]
        },
        {
          "name": "구매 자료 수정",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{ \"name\": \"수정된 Postman 이용 링크\" }" }, "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/resources/{{resourceId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.name).to.eql('수정된 Postman 이용 링크');"] } }]
        },
        {
          "name": "구매 자료 삭제",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}/resources/{{resourceId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().success).to.eql(true);"] } }]
        },
        {
          "name": "상품 삭제 - 논리 삭제",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/seller/products/{{sellerProductId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().message).to.eql('상품이 삭제되었습니다.');"] } }]
        }
      ]
    }
  ]
}
