{
  "info": {
    "_postman_id": "3fd49b03-9ca6-44f1-b614-05dcff9d5c20",
    "name": "Assetory - Phase 03 Public Explore",
    "description": "3단계 공개 탐색 API 검증용 Collection입니다. 로컬 환경을 선택한 뒤 폴더 또는 전체 Runner를 실행하세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "draftProductId",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "1. Categories",
      "item": [
        {
          "name": "카테고리 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('공통 성공 응답과 카테고리 배열', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "상품 목록 - 최신순",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?page=0&size=20&sort=LATEST"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('페이지 응답 구조', () => {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.products).to.be.an('array');",
                  "  pm.expect(body.data).to.have.keys('products', 'page', 'size', 'totalElements', 'totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 목록 - 개발 카테고리",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?categoryId=2&page=0&size=20&sort=LATEST"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('개발 카테고리 상품 1건', () => pm.expect(body.data.totalElements).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 목록 - 키워드 검색",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?keyword=React&page=0&size=20&sort=LATEST"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('React 검색 결과', () => pm.expect(body.data.products[0].name).to.include('React'));"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 목록 - 인기순",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?page=0&size=20&sort=POPULAR"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json().data.products;",
                  "pm.test('후기 수 내림차순', () => {",
                  "  pm.expect(products[0].reviewCount).to.be.at.least(products[1].reviewCount);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 목록 - 잘못된 정렬값",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?sort=WRONG"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('INVALID_INPUT 오류', () => {",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.data.code).to.eql('INVALID_INPUT');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Product Detail",
      "item": [
        {
          "name": "공개 상품 상세 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().data;",
                  "pm.test('상세 응답에 이미지·후기 집계 포함', () => {",
                  "  pm.expect(product.images).to.be.an('array');",
                  "  pm.expect(product).to.have.property('averageRating');",
                  "  pm.expect(product).to.have.property('reviewCount');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "임시저장 상품은 비공개",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{draftProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('PRODUCT_NOT_FOUND 오류', () => pm.expect(pm.response.json().data.code).to.eql('PRODUCT_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Reviews",
      "item": [
        {
          "name": "공개 후기 목록 - 최신순",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews?sort=LATEST&page=0&size=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('후기 페이지 응답 구조', () => {",
                  "  pm.expect(data.reviews).to.be.an('array');",
                  "  pm.expect(data).to.have.keys('reviews', 'page', 'size', 'totalElements', 'totalPages');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "공개 후기 목록 - 평점 낮은순·페이지네이션",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews?sort=RATING_LOW&page=0&size=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('낮은 평점순과 페이지 크기', () => {",
                  "  pm.expect(data.reviews[0].rating).to.be.at.most(data.reviews[1].rating);",
                  "  pm.expect(data.size).to.eql(2);",
                  "  pm.expect(data.totalPages).to.eql(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "후기 목록 - 잘못된 정렬값",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}/reviews?sort=WRONG"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('INVALID_INPUT 오류', () => pm.expect(pm.response.json().data.code).to.eql('INVALID_INPUT'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
